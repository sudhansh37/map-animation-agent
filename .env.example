# Copy this file to ".env" and fill in your values.
# NEVER commit the real .env file. On GitHub, put these in Repository Secrets.

# ---- Gemini (brain + TTS) ----
# Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- YouTube upload (OAuth) ----
# Create an OAuth 2.0 Client (Desktop/Web) in Google Cloud Console.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# One-time: run scripts/get_refresh_token.py locally to obtain this.
YOUTUBE_REFRESH_TOKEN=

# ---- Optional: Hugging Face (only if you switch the image engine to HF) ----
HF_TOKEN=

# ---- Optional: local text-to-image ----
ENABLE_IMAGE_GEN=false
